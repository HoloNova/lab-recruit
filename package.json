{
  "name": "lab-recruit",
  "version": "2.0.0",
  "description": "网络攻防与信息安全实验室招新网站",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "review": "node --env-file-if-exists=.env scripts/review.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "svg-captcha": "^1.4.0"
  }
}
