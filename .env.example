# 复制为 .env 后修改；.env 不要提交到 git
#   cp .env.example .env && chmod 600 .env

PORT=3001
DB_PATH=/app/data/data.db

# 写接口的 Origin 白名单。必须是精确 origin（含协议），
# 校验用字符串全等比较，禁止后缀匹配。
ALLOWED_ORIGIN=https://join.campuslink.vip

# 三个互相独立的 HMAC 密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ⚠ 一旦设定不可更改：改了会导致所有编辑码失效、验证码校验失败、IP 风控失配。
# ⚠ 备份数据库时必须连同本文件一起备份。
PEPPER_CAPTCHA=
PEPPER_EDIT=
PEPPER_IP=

# 验证码看不清 / 编辑码丢失时的人工兜底联系方式
CONTACT_EMAIL=

# 只信任一层反向代理（nginx）。设成 true 会让客户端伪造
# X-Forwarded-For 污染 IP 风控；不设则所有请求来源都变成 127.0.0.1。
TRUST_PROXY=1

# https 环境下必须为 1（启用 __Host- cookie 前缀）。
# 本地 http 开发时设为 0。
COOKIE_SECURE=1

# 现有 nginx 容器所在的 Docker 网络名。查看方式：
#   docker inspect <nginx容器名> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
NGINX_NETWORK=

# bind mount 的 data/ 属主 uid:gid，与宿主机 `id -u` / `id -g` 一致
PUID=1000
PGID=1000

# 全站报名总量熔断（默认 2000）
# TOTAL_CAP=2000
